parser ingress:
  start: $entry_point.start
  init_zero: [ B0, H0, B1 ]
  hdr_len_adj: 16
  states:
    $entry_point.start:
      *:
        8..9: TH8  # ingress::hdr.eth_hdr.dst_addr[47:32].32-47
        10..13: TW5  # ingress::hdr.eth_hdr.dst_addr[31:0].0-31
        14..15: TH7  # ingress::hdr.eth_hdr.src_addr[47:32].32-47
        16..19: TW4  # ingress::hdr.eth_hdr.src_addr[31:0].0-31
        20..21: TH6  # ingress::hdr.eth_hdr.eth_type
        22..23: H1  # ingress::hdr.a.first
        B1: 15
            # - value 1 -> B1 bit[0]: ingress::hdr.eth_hdr.$valid
            # - value 1 -> B1 bit[1]: ingress::hdr.a.$valid
            # - value 1 -> B1 bit[2]: ingress::hdr.b.$valid
            # - value 1 -> B1 bit[3]: ingress::hdr.c.$valid
        shift: 24
        buf_req: 24
        next: $entry_point.start.$split_0
    $entry_point.start.$split_0:
      *:
        0..1: H2  # ingress::hdr.b.first
        2..3: H3  # ingress::hdr.c.first
        shift: 4
        buf_req: 4
        next: end
deparser ingress:
  dictionary:
    TH8: B1(0)  # ingress::hdr.eth_hdr.dst_addr.32-47 if ingress::hdr.eth_hdr.$valid
    TW5: B1(0)  # ingress::hdr.eth_hdr.dst_addr.0-31 if ingress::hdr.eth_hdr.$valid
    TH7: B1(0)  # ingress::hdr.eth_hdr.src_addr.32-47 if ingress::hdr.eth_hdr.$valid
    TW4: B1(0)  # ingress::hdr.eth_hdr.src_addr.0-31 if ingress::hdr.eth_hdr.$valid
    TH6: B1(0)  # ingress::hdr.eth_hdr.eth_type if ingress::hdr.eth_hdr.$valid
    H1: B1(0)  # ingress::hdr.a.first if ingress::hdr.eth_hdr.$valid
    H2: B1(0)  # ingress::hdr.b.first if ingress::hdr.eth_hdr.$valid
    H3: B1(0)  # ingress::hdr.c.first if ingress::hdr.eth_hdr.$valid
  mirror:
    select: B0(0..2)  # bit[2..0]: ingress::ig_intr_md_for_dprsr.mirror_type
    0:
      - H0(0..9)  # bit[9..0]: ingress::$tmp2
parser egress:
  start: $entry_point.start.min_parse_depth_accept_initial
